---
import type { Locale } from "../config/i18n";
import { localizePath } from "../config/i18n";
import ProjectLinkList from "./ProjectLinkList.astro";
import type { ProjectEntry } from "../lib/content";
interface Props { project: ProjectEntry; locale: Locale }
const { project, locale } = Astro.props;
---
{project.data.github.length > 0 && <section class="related-content" aria-labelledby="project-github-heading">
  <h2 id="project-github-heading">GitHub</h2><ProjectLinkList entries={project.data.github} />
</section>}
{project.data.documents.length > 0 && <section class="related-content" aria-labelledby="project-documentation-heading">
  <h2 id="project-documentation-heading">{locale === "en" ? "Documentation" : "文档"}</h2>
  <ProjectLinkList label={locale === "en" ? "Documentation" : "项目文档"} entries={[{ title: locale === "en" ? "Browse project documentation" : "查看项目文档", url: localizePath(locale, `/projects/${project.id}/docs/`), description: locale === "en" ? `${project.data.documents.length} documents` : `${project.data.documents.length} 篇文档` }]} />
</section>}
