---
import ContentEntryList from "./ContentEntryList.astro";

import { DEFAULT_LOCALE, type Locale } from "../config/i18n";
import type { ArticleEntry } from "../lib/content";
import { articleHref } from "../lib/content";

interface Props {
  entries: ArticleEntry[];
  emptyMessage?: string;
  locale?: Locale;
  languageFallbackLabel?: string;
}

const {
  entries,
  locale = entries[0]?.data.language ?? DEFAULT_LOCALE,
  emptyMessage = locale === "en" ? "There are no published articles here yet." : "这里还没有已发布文章。",
  languageFallbackLabel,
} = Astro.props;
---
<ContentEntryList locale={locale} emptyMessage={emptyMessage} items={entries.map((entry) => ({
  href: articleHref(entry), title: entry.data.title, description: entry.data.description,
  language: entry.data.language, updatedAt: entry.data.updatedAt ?? entry.data.publishedAt,
  draft: entry.data.status === "draft",
  label: entry.data.language !== locale && languageFallbackLabel ? languageFallbackLabel : entry.data.language === "en" ? "English" : entry.data.tags[0] ?? "技术文章",
}))} />
