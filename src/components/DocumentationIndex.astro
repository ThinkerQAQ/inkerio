---
import type { Locale } from "../config/i18n";
import type { SeriesEntry } from "../lib/content";
import { documentHref, seriesDocuments, type DocumentEntry } from "../lib/documentation";
interface Props { series: SeriesEntry; documents: DocumentEntry[]; locale: Locale }
const { series, documents, locale } = Astro.props;
const entries = seriesDocuments(series, documents, locale);
---
<nav aria-label={locale === "en" ? "Documentation contents" : "文档目录"}>
  <ol class="content-list">
    {entries.map((entry, index) => <li><div class="content-list-main">
      <a class="content-title" href={documentHref(entry)}>{index + 1}. {entry.data.title}</a>
      <p>{entry.data.description}</p>
    </div>{entry.data.language !== locale && <span class="content-meta">中文</span>}</li>)}
  </ol>
  {entries.length === 0 && <p class="empty-state">{locale === "en" ? "Documentation is being prepared." : "文档正在整理中。"}</p>}
</nav>
