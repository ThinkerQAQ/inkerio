---
import { getCollection } from "astro:content";
import ProjectReadingPage from "../../../components/ProjectReadingPage.astro";
import { LOCALES, nonDefaultLocales } from "../../../config/i18n";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return nonDefaultLocales().flatMap((locale) => projects.map((project) => ({ params: { locale: LOCALES[locale].path, slug: project.id }, props: { project, locale } })));
}
const { project, locale } = Astro.props;
const readmes = await getCollection("projectReadmes");
const translations = await getCollection("projectTranslations");
const documents = await getCollection("documents");
---
<ProjectReadingPage project={project} locale={locale} readmes={readmes} translations={translations} documents={documents} />
