---
import { getCollection } from "astro:content";
import DocumentLayout from "../../../../../layouts/DocumentLayout.astro";
import { validateDocuments } from "../../../../../lib/documentation";
export async function getStaticPaths() {
  const documents = await getCollection("documents");
  const seriesEntries = await getCollection("series");
  validateDocuments(documents, seriesEntries);
  return documents.filter((entry) => entry.data.language !== "zh").map((document) => ({
    params: { locale: document.data.language, series: document.data.series, slug: (document.data.translationOf ?? document.id).replace(/^en\//, "") },
    props: { document, documents, series: seriesEntries.find((entry) => entry.id === document.data.series)! },
  }));
}
const { document, documents, series } = Astro.props;
---
<DocumentLayout document={document} documents={documents} series={series} />
