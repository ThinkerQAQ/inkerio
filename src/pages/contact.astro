---
import CollectionHeader from "../components/CollectionHeader.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
const githubURL = new URL(SITE.github);
const githubLabel = githubURL.host + githubURL.pathname.replace(/\/$/, "");
---

<BaseLayout
  title="联系"
  description={`联系 ${SITE.author}：技术讨论、文章反馈或合作事宜。`}
  canonicalPath="/contact/"
>
  <div class="shell page narrow collection-page">
    <CollectionHeader
      title="联系"
      description="技术讨论、文章反馈或合作事宜，欢迎通过邮箱联系。"
    />

    <div class="prose">
      {SITE.contactEmail && (
        <>
          <h2>邮箱</h2>
          <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
        </>
      )}
      <h2>GitHub</h2>
      <p>
        <a href={SITE.github}>{githubLabel}</a>
      </p>
      <p>
        具体代码或项目问题，也可以在对应的 GitHub 仓库中讨论。
      </p>
    </div>
  </div>
</BaseLayout>
