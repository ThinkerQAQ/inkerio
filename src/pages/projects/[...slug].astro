---
import { getCollection } from "astro:content";
import ProjectReadingPage from "../../components/ProjectReadingPage.astro";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, locale: "zh" as const } }));
}
const { project, locale } = Astro.props;
const readmes = await getCollection("projectReadmes");
const translations = await getCollection("projectTranslations");
const seriesEntries = await getCollection("series");
const documents = await getCollection("documents");
---
<ProjectReadingPage project={project} locale={locale} readmes={readmes} translations={translations} seriesEntries={seriesEntries} documents={documents} />
