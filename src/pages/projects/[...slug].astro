---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ProjectKnowledgeIndex from "../../components/ProjectKnowledgeIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, projectStatus, projectHref } from "../../lib/content";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const seriesEntries = await getCollection("series");
const translations = await getCollection("projectTranslations");
---

<BaseLayout title={data.title} description={data.description} languageAlternatives={[{ locale: "zh", href: projectHref(project) }, ...translations.filter((entry) => entry.data.translationOf === project.id).map((entry) => ({ locale: entry.data.language, href: projectHref(project, entry.data.language) }))]}>
  <div class="shell page detail-page">
    <article data-pagefind-body data-pagefind-filter="type:Project">
      <header class="note-header detail-page-header">
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <p class="note-description">{data.description}</p>
        <div class="note-meta">
          <span>{projectStatus[data.status]}</span>
          <span>更新于 {formatDate(data.updatedAt)}</span>
        </div>
      </header>
      <div class="prose"><Content /></div>
      <ProjectKnowledgeIndex
        project={project}
        seriesEntries={seriesEntries}
        locale="zh"
      />
    </article>
  </div>
</BaseLayout>
