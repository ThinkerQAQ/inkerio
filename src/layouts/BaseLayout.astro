---
import AskBlogSession from "../components/AskBlogSession.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  DEFAULT_LOCALE,
  LOCALES,
  languageAlternativesForPath,
  localizePath,
  unlocalizePath,
  type Locale,
  type LocaleAlternative,
} from "../config/i18n";
import { SITE } from "../config/site";
import { SITE_FEATURES } from "../config/site-features";
import { resolveAnalyticsIntegration } from "../lib/site-integrations.mjs";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonicalPath?: string;
  language?: string;
  locale?: Locale;
  languageAlternatives?: LocaleAlternative[];
  languageSwitcherAlternatives?: LocaleAlternative[];
  analytics?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  type = "website",
  canonicalPath = Astro.url.pathname,
  locale = DEFAULT_LOCALE,
  language = LOCALES[locale].htmlLang,
  languageAlternatives: providedLanguageAlternatives,
  languageSwitcherAlternatives: providedLanguageSwitcherAlternatives,
  analytics = true,
  image,
  imageAlt,
} = Astro.props;

// The language switcher belongs to the global navigation, so it must remain
// available on every page. hreflang answers the stricter SEO question "where
// is the true localized equivalent of this content?" and may therefore be
// sparse. When an exact localized content route does not exist, the switcher
// falls back to the corresponding localized section instead of disappearing.
const localizedSeoShellPaths = new Set([
  "/",
  "/articles/",
  "/series/",
  "/projects/",
  "/about/",
  "/contact/",
]);
const logicalPath = unlocalizePath(Astro.url.pathname);
const normalizedLogicalPath =
  logicalPath === "/" ? "/" : `${logicalPath.replace(/\/+$/, "")}/`;
const inferredLanguageAlternatives = localizedSeoShellPaths.has(normalizedLogicalPath)
  ? languageAlternativesForPath(normalizedLogicalPath)
  : [];
const exactSwitcherAlternatives = languageAlternativesForPath(normalizedLogicalPath);
const inferredLanguageSwitcherAlternatives = exactSwitcherAlternatives.map((alternative) => {
  if (alternative.locale === locale) return alternative;

  const exactProvidedAlternative = providedLanguageAlternatives?.find(
    (candidate) => candidate.locale === alternative.locale,
  );
  if (exactProvidedAlternative) return exactProvidedAlternative;

  if (normalizedLogicalPath.startsWith("/articles/") && normalizedLogicalPath !== "/articles/") {
    return { locale: alternative.locale, href: localizePath(alternative.locale, "/articles/") };
  }
  if (normalizedLogicalPath.startsWith("/series/") && normalizedLogicalPath !== "/series/") {
    return { locale: alternative.locale, href: localizePath(alternative.locale, "/series/") };
  }
  if (normalizedLogicalPath.startsWith("/notes/tags/")) {
    return { locale: alternative.locale, href: localizePath(alternative.locale, "/notes/") };
  }

  return alternative;
});
const languageAlternatives = providedLanguageAlternatives ?? inferredLanguageAlternatives;
const languageSwitcherAlternatives = providedLanguageSwitcherAlternatives
  ?? inferredLanguageSwitcherAlternatives;
const pageTitle =
  title === SITE.title && normalizedLogicalPath === "/"
    ? LOCALES[locale].homeTitle
    : title === SITE.title
      ? title
      : `${title} · ${SITE.title}`;
const canonical = new URL(canonicalPath, SITE.url);
const socialImage = image ? new URL(image, SITE.url).toString() : undefined;
const defaultAlternative = languageAlternatives.find(
  (alternative) => alternative.locale === DEFAULT_LOCALE,
);
// Optional feature adapters stay disabled unless a site explicitly opts in.
// A deployed AI Search Worker or indexed content alone must never enable chat.
const askBlogEnabled = import.meta.env.PUBLIC_ASK_BLOG_ENABLED === "true"
  && Boolean(import.meta.env.PUBLIC_ASK_BLOG_WORKER_URL?.trim())
  && Boolean(import.meta.env.PUBLIC_ASK_BLOG_TURNSTILE_SITE_KEY?.trim());
const analyticsIntegration = resolveAnalyticsIntegration(SITE_FEATURES.integrations.analytics, {
  PUBLIC_UMAMI_WEBSITE_ID: import.meta.env.PUBLIC_UMAMI_WEBSITE_ID,
  PUBLIC_UMAMI_PROXY_ORIGIN: import.meta.env.PUBLIC_UMAMI_PROXY_ORIGIN,
});
const umamiDomain = new URL(SITE.url).hostname;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    {languageAlternatives.map((alternative) => (
      <link
        rel="alternate"
        hreflang={LOCALES[alternative.locale].htmlLang}
        href={new URL(alternative.href, SITE.url)}
      />
    ))}
    {defaultAlternative && (
      <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternative.href, SITE.url)} />
    )}
    <link rel="icon" href="/brand-mark.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={locale === "en" ? "/en/rss.xml" : "/rss.xml"} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={language.replace("-", "_")} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {analytics && analyticsIntegration?.provider === "umami" && (
      <script
        is:inline
        defer
        src={analyticsIntegration.src}
        data-website-id={analyticsIntegration.websiteId}
        data-domains={umamiDomain}
        data-host-url={analyticsIntegration.collectorOrigin}
        data-exclude-hash="true"
        data-performance="true"
      ></script>
    )}
    {analytics && analyticsIntegration?.provider === "script" && (
      <script is:inline defer src={analyticsIntegration.src} {...analyticsIntegration.attributes}></script>
    )}
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={noindex ? "all" : undefined}>
    <a class="skip-link" href="#main-content">{LOCALES[locale].ui.skipToContent}</a>
    <SiteHeader locale={locale} languageAlternatives={languageSwitcherAlternatives} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    {askBlogEnabled && <AskBlogSession locale={locale} />}
    <script>
      import { initFloatingActionLayout } from "../lib/floating-actions-runtime.js";

      initFloatingActionLayout();
    </script>
  </body>
</html>
