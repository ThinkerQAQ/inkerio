---
import type { CollectionEntry } from "astro:content";
import ContentComments from "../components/ContentComments.astro";
import ContentReaction from "../components/ContentReaction.astro";
import CopyrightNotice from "../components/CopyrightNotice.astro";
import RelatedContent from "../components/RelatedContent.astro";
import { RELATED_CONTENT_UI } from "../config/i18n-features";
import { DEFAULT_LOCALE, LOCALES, pathForLocale, type LocaleAlternative } from "../config/i18n";
import { SITE } from "../config/site";
import { SITE_WEBSITE_ID, siteAuthorSchema } from "../lib/structured-data";
import { articleHref, articleTagHref, localizedProjectSummary, localizedSeriesSummary, noteHref, projectHref, seriesHref, type ArticleSeriesNavigation as SeriesNavigation } from "../lib/content";
import type { ProjectRelation } from "../lib/project-relations";
import { articleSourceHref } from "../lib/article-source.mjs";
import ReadingLayout from "./ReadingLayout.astro";
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: CollectionEntry<"articles">;
  headings: Heading[];
  readingMinutes: number;
  translations?: CollectionEntry<"articles">[];
  seriesNavigation?: SeriesNavigation;
  relatedNotes?: CollectionEntry<"notes">[];
  projectRelation?: ProjectRelation;
}

const {
  article,
  headings,
  readingMinutes,
  translations = [article],
  seriesNavigation,
  relatedNotes = [],
  projectRelation,
} = Astro.props;
const { data } = article;
const socialCoverImage = data.coverImage?.endsWith(".svg")
  ? data.coverImage.replace(/\.svg$/i, ".jpg")
  : data.coverImage;
const locale = data.language;
const localeInfo = LOCALES[locale];
const relatedUi = RELATED_CONTENT_UI[locale];
const articlePath = articleHref(article);
const commentRoot = translations.find((entry) => entry.data.language === DEFAULT_LOCALE);
if (!commentRoot) {
  throw new Error(`Article ${article.id}: missing default-locale translation root for comments`);
}
const commentThreadPath = articleHref(commentRoot);
const languageAlternatives: LocaleAlternative[] = translations.map((entry) => ({
  locale: entry.data.language,
  href: articleHref(entry),
}));
const seriesSummary = seriesNavigation
  ? localizedSeriesSummary(seriesNavigation.series, locale)
  : undefined;
const projectSummary = projectRelation
  ? localizedProjectSummary(projectRelation.project, locale)
  : undefined;
const collection = seriesNavigation && seriesSummary ? {
  label: localeInfo.ui.seriesLabel,
  title: seriesSummary.title,
  href: seriesHref(seriesNavigation.series, locale),
  groups: [{
    items: seriesNavigation.articles.map((entry, index) => ({
      href: articleHref(entry),
      title: entry.data.title,
      current: index === seriesNavigation.currentIndex,
    })),
  }],
} : undefined;
const sourceNoteHref = data.sourceNote ? pathForLocale(data.sourceNote, locale) : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: siteAuthorSchema(),
  isPartOf: { "@id": SITE_WEBSITE_ID },
  inLanguage: localeInfo.htmlLang,
  mainEntityOfPage: new URL(articlePath, SITE.url).toString(),
  ...(socialCoverImage ? { image: new URL(socialCoverImage, SITE.url).toString() } : {}),
};
---
<ReadingLayout title={data.title} description={data.description} locale={locale} canonicalPath={articlePath}
  contentType="article" contentId={article.id} seriesId={data.series} headings={headings} readingMinutes={readingMinutes}
  publishedAt={data.publishedAt} updatedAt={data.updatedAt} draft={data.status === "draft"}
  languageAlternatives={languageAlternatives} collection={collection}
  previous={seriesNavigation?.previous && { href: articleHref(seriesNavigation.previous), title: seriesNavigation.previous.data.title }}
  next={seriesNavigation?.next && { href: articleHref(seriesNavigation.next), title: seriesNavigation.next.data.title }}
  image={data.coverImage} socialImage={socialCoverImage} imageAlt={data.coverImageAlt}
  markdownSourceUrl={articleSourceHref(article.id)} defaultView={data.defaultView}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
  <Fragment slot="headerContext">
    {data.tags.length > 0 && <div class="tag-list" aria-label={localeInfo.ui.tags}>{data.tags.map((tag) => <a href={pathForLocale(articleTagHref(tag), locale)} rel="tag">{tag}</a>)}</div>}
    {projectRelation && projectSummary && <div class="tag-list" aria-label={locale === "en" ? "Project context" : "项目关联"}><a href={projectHref(projectRelation.project, locale)}>{locale === "en" ? "Project" : "项目"} · {projectSummary.title}</a></div>}
  </Fragment>
  <slot />
  <Fragment slot="afterBody">
    <CopyrightNotice locale={locale} />
    <ContentReaction contentType="article" contentId={article.id} language={locale} />
    <RelatedContent headingId="related-notes-heading" title={relatedUi.relatedNotes} items={relatedNotes.map((note) => ({ href: noteHref(note, locale), title: note.data.title, description: note.data.description }))} />
  </Fragment>
  <Fragment slot="afterNavigation">
    {sourceNoteHref && (locale === "zh" ? <p class="source-note">本文迁移自<a href={sourceNoteHref}>原始学习笔记</a>，文章版本独立维护。</p> : <p class="source-note">This article was migrated from the <a href={sourceNoteHref}>original learning notes</a> and is maintained independently.</p>)}
    <ContentComments language={locale} threadPath={commentThreadPath} />
  </Fragment>
</ReadingLayout>
